# SPENDY · Variables de configuración del OCR (RNF-18).
#
# 1. Copia este archivo:      cp .env.example .env
# 2. Llena los valores reales en .env (nunca en este archivo).
# 3. Corre la app con ellos:  flutter run --dart-define-from-file=.env
#    APK:                     flutter build apk --dart-define-from-file=.env
#
# .env está en .gitignore: la clave nunca se sube al repositorio.
# Si dejas todo vacío, la app lee los recibos con Google ML Kit en el teléfono.

# --- Gemini (Google AI Studio), proveedor elegido ---------------------------
# En el teléfono la clave se captura en Ajustes -> Lectura de recibos y se
# guarda en el almacenamiento seguro (desde v1.1.0 NO se compila en el APK).
# Esta variable solo se lee del entorno en escritorio y pruebas.
SPENDY_GEMINI_API_KEY=

# Modelos de Gemini en orden, separados por comas. Si uno está saturado o sin
# cuota se prueba el siguiente. Vacío = gemini-flash-lite-latest,gemini-flash-latest.
SPENDY_GEMINI_MODEL=

# --- Otro servicio de OCR en la nube (opcional, en lugar de Gemini) ---------
# URL del servicio de OCR. Solo se acepta https:// (RNF-16).
SPENDY_OCR_ENDPOINT=

# Clave del servicio de OCR. Se envía como "Authorization: Bearer <clave>".
SPENDY_OCR_API_KEY=

# Nombre del proveedor que aparece en el aviso de privacidad (RNF-17, RF-51).
SPENDY_OCR_PROVIDER_NAME=
