# SPENDY · Variables de configuración del adaptador de OCR (RNF-18).
#
# NO hace falta para leer recibos: por defecto la app usa Google ML Kit dentro
# del teléfono, sin clave ni internet. Llena esto solo si quieres usar en su
# lugar un servicio de OCR en la nube (CloudOcrAdapter).
#
# 1. Copia este archivo:      cp .env.example .env
# 2. Llena los valores reales en .env (nunca en este archivo).
# 3. Corre la app con ellos:  flutter run --dart-define-from-file=.env
#
# .env está en .gitignore: la clave nunca se sube al repositorio.
# Si dejas las variables vacías, la app lee los recibos con ML Kit.

# URL del servicio de OCR. Solo se acepta https:// (RNF-16).
SPENDY_OCR_ENDPOINT=

# Clave del servicio de OCR. Se envía como "Authorization: Bearer <clave>".
SPENDY_OCR_API_KEY=

# Nombre del proveedor que aparece en el aviso de privacidad (RNF-17, RF-51).
# Si queda vacío, el aviso dice "un servicio externo de lectura de recibos (OCR)".
SPENDY_OCR_PROVIDER_NAME=
