<?xml version="1.0" encoding="utf-8"?>
<!-- AUD-03 · Android 12 o superior: nada de la app va al respaldo en la nube
     ni a la transferencia a otro teléfono. La copia de los datos es la copia
     cifrada de Spendy (Ajustes > Copia de seguridad). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
